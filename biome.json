{
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"files": {
		"includes": [
			"js/**/*.js",
			"scripts/**/*.js",
			"functions/**/*.js",
			"css/**/*.css",
			"package.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"suspicious": {
				"noDoubleEquals": "off"
			},
			"complexity": {
				"noForEach": "off",
				"noImportantStyles": "off"
			},
			"style": {
				"noDescendingSpecificity": "off"
			}
		}
	}
}
